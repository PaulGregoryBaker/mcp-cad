{
  "tool": "validate_assembly",
  "description": "Performs comprehensive geometry and assembly verification, checking for sheet metal unfoldability and adjacent part overlaps, returning detailed errors and autofix tool recommendations.",
  "parameters": {
    "type": "object",
    "properties": {
      "part_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional list of part IDs to check. If omitted, checks all parts in the workspace."
      },
      "sheet_metal_flags": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        },
        "description": "Optional overrides to flag parts as sheet metal (true) or non-sheet-metal (false). Default is true for all parts."
      }
    }
  },
  "response": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean",
        "description": "True if the assembly has zero errors, false otherwise."
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "category": {
              "type": "string",
              "enum": ["sheet_metal", "clash_detection", "semantic_graph", "manufacturing", "nesting"]
            },
            "severity": {
              "type": "string",
              "enum": ["error", "warning", "info"]
            },
            "message": { "type": "string" },
            "affected_part_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "autofix": {
              "type": "object",
              "properties": {
                "tool_name": { "type": "string" },
                "arguments": { "type": "object" }
              },
              "required": ["tool_name", "arguments"]
            }
          },
          "required": ["id", "category", "severity", "message", "affected_part_ids"]
        }
      },
      "summary": {
        "type": "object",
        "properties": {
          "total_parts_checked": { "type": "integer" },
          "rule_count": { "type": "integer" },
          "execution_time_ms": { "type": "integer" }
        },
        "required": ["total_parts_checked", "rule_count", "execution_time_ms"]
      }
    },
    "required": ["valid", "errors", "summary"]
  }
}
