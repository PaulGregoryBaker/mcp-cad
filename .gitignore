# ─── Build outputs ──────────────────────────────────────────────────────────
# Wildcard rather than enumerating each named variant (build/, build-asan/,
# build-debug/, build-vcpkg/, build-napi/, ...) — new ad-hoc build dirs must not
# need a .gitignore edit to stay untracked.
cpp/build*/
cpp/src/napi/build/
ts/dist/
ts/coverage/
Testing/

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
ts/node_modules/
/opt/vcpkg/

# ─── Runtime state ───────────────────────────────────────────────────────────
state/

# ─── Tool caches ─────────────────────────────────────────────────────────────
.claude/
cpp/tests/fixtures/.formaition/

# ─── C++ artifacts ───────────────────────────────────────────────────────────
*.o
*.so
*.a
*.node
*.exe
*.dll
*.lib

# ─── Python artifacts ────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ─── Logs and temp ───────────────────────────────────────────────────────────
*.log
*.tmp
*.swp
*.bak
asan.log*
docs/test-reports/*.xml
docs/test-reports/*.log
docs/test-reports/*.json

# ─── Environment ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── vcpkg installed ─────────────────────────────────────────────────────────
cpp/vcpkg_installed/

# ─── spikes ─────────────────────────────────────────────────────────
rebuild/spikes/

# ─── debug files ─────────────────────────────────────────────────────────
*.txt